# Passo 1: Use uma imagem base oficial e leve do Python (Debian)
FROM python:3.10-slim

# Definir variável de ambiente para o local do código (convencional para Lambda)
ENV LAMBDA_TASK_ROOT=/var/task
WORKDIR ${LAMBDA_TASK_ROOT}

# Passo 2: Instalar dependências de sistema mínimas (gcc, make, etc. para awslambdaric se não houver wheel)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    g++ \
    make \
    cmake \
    unzip \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Passo 3: Copie o arquivo de dependências
COPY requirements.txt .

# Passo 4: Instale as dependências + awslambdaric
RUN pip install --upgrade pip && \
    pip install awslambdaric && \
    pip install --no-cache-dir -r requirements.txt

# Passo 5: Copie o código da aplicação
COPY . ${LAMBDA_TASK_ROOT}

# Passo 6: Configurar Entrypoint para o RIC
ENTRYPOINT [ "/usr/local/bin/python", "-m", "awslambdaric" ]

# Passo 7: Comando padrão (handler)
CMD ["app.main.handler"]
